[Unit]
Description=instrument-cluster
# Deliberately NOT ordered after local-fs.target (which DefaultDependencies
# would imply via basic.target): starting early lets the ~3 s of Python/
# pygame/numpy imports overlap the /data ext4 journal replay that follows a
# power cut. The app waits for /data itself right before reading its config
# (main._wait_for_config_volume), so nothing here races the mount.
DefaultDependencies=no
Requires=splashscreen.service
# splashscreen is pulled up by udev the moment /dev/fb0 exists, so ordering
# after it also guarantees the display stack is probed before SDL starts.
After=splashscreen.service systemd-journald.socket
# DefaultDependencies=no also drops the implicit shutdown ordering — put it
# back so the app still stops cleanly on reboot/poweroff.
Conflicts=shutdown.target
Before=shutdown.target

StartLimitIntervalSec=60
StartLimitBurst=3
StartLimitAction=reboot

[Service]
# we use notify so systemd knows when initialization is actually done
Type=notify

# enable the hardware/software watchdog timer
# if the python loop hangs for 30 seconds systemd kills the app
WatchdogSec=30

Environment=SDL_VIDEODRIVER=kmsdrm
# Pi 5 split DRM: rp1-dsi display card has no Mesa DRI driver; V3D does.
# Force Mesa to load v3d_dri.so so EGL can initialise against the display card.
Environment=MESA_LOADER_DRIVER_OVERRIDE=v3d
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYOPENGL_PLATFORM=egl
Environment=PYTHON_BASIC_REPL=1
Environment=IC_CONFIG_PATH=/data/config/instrument-cluster.json
ExecStart=/usr/bin/instrument-cluster

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target