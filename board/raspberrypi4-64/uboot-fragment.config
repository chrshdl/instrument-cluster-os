# Redundant environment in raw MMC (gap before the first partition,
# offsets mirrored in genimage.cfg and /etc/fw_env.config). Two copies
# with alternating writes: an interrupted saveenv/fw_setenv leaves the
# other copy valid, closing the power-cut-during-env-write brick.
# CONFIG_ENV_IS_IN_FAT is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_ENV_OFFSET=0x400000
CONFIG_ENV_OFFSET_REDUND=0x404000
CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
CONFIG_ENV_SIZE=0x4000

CONFIG_BOOTDELAY=0

# CONFIG_USB is not set
# CONFIG_CMD_USB is not set
# CONFIG_USB_HOST is not set

# CONFIG_NET is not set
# CONFIG_CMD_NET is not set

# CONFIG_DM_VIDEO is not set
# CONFIG_VIDEO is not set
# Load the kernel from the active rootfs slot (boot.scr ext4load)
CONFIG_CMD_EXT4=y
CONFIG_FS_EXT4=y
