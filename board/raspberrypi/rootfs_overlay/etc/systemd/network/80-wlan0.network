[Match]
Name=wlan0

[Network]
# IPv4 only, deliberately. The kernel builds IPv6 as a module
# (CONFIG_IPV6=m), so if it is not loaded, every IPv6 step here — router
# advertisements, DHCPv6 (which plain "DHCP=yes" also requests), and the
# default IPv6 link-local address — fails. networkd treats that as a
# failure of the whole link (SETUP=failed) and then never runs DHCPv4
# either, leaving an associated radio with no address at all. Nothing the
# cluster does needs IPv6.
DHCP=ipv4
IPv6AcceptRA=no
LinkLocalAddressing=no
# Make resolved answer mDNS for <hostname>.local on this link. Without
# this line the device advertises NO name at all: resolved is built with
# mDNS on globally, but networkd defaults every managed link to MDNS=no
# and resolved clamps to MIN(link, global) — the working
# instrument-cluster.local on the dev LAN turned out to be the router
# (a Fritz!Box) answering for its DHCP clients, which most routers do
# not do. The ACC agent's output_mdns sink, the documented ssh workflow,
# and the telemetry protocol's addressing convention (revokyte
# docs/PROTOCOL.md §2.5) all assume the name follows the device across
# DHCP lease changes, so the image must guarantee it itself.
MulticastDNS=yes

[DHCPv4]
# Identify by MAC rather than by the default DUID, which is derived from
# /etc/machine-id. That symlink points onto /data (the rootfs is read
# only) and a release image once shipped with nothing to create the
# target, so networkd failed with "Failed to configure DHCPv4 client: No
# such file or directory" and then failed the whole link — an associated
# radio with no address. prepare-data-dirs.service now provisions the
# machine ID, but DHCP has no reason to depend on it at all, and a
# MAC-based client id also gives the router a stable identity for this
# device across reflashes. UseDNS already defaults to yes.
ClientIdentifier=mac
